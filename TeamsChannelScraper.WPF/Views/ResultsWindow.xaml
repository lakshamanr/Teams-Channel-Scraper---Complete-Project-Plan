<Window x:Class="TeamsChannelScraper.WPF.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scraping Results — TCIE"
        Height="640" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <DockPanel Margin="12">

        <!-- ══ Top: Stats bar ══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run FontWeight="SemiBold" Text="Messages: "/>
                        <Run Text="{Binding TotalMessages, Mode=OneWay}"/>
                        <Run Text="   "/>
                        <Run FontWeight="SemiBold" Text="Threads: "/>
                        <Run Text="{Binding TotalThreads, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Export All" Command="{Binding ExportCommand}" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Search bar ══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍  Search:"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter threads by category, author, or message content"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Clear"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ══ Category stats row ══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding CategoryStats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AppBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="10,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Category}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding Count}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ══ Main split: thread list + preview ══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thread list -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding FilteredThreads}"
                         SelectedItem="{Binding SelectedThread}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Border Background="{StaticResource AccentBrush}"
                                                CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding InferredCategory}"
                                                       Foreground="White" FontSize="10"
                                                       FontFamily="Segoe UI" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Root.Author}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Root.Content}"
                                               FontFamily="Segoe UI" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="280"/>
                                    <TextBlock FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding Root.Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding TotalCount}"/>
                                        <Run Text=" msg(s)"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Markdown preview -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="12">
                <TextBox Text="{Binding SelectedMarkdown, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas" FontSize="12"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>

    </DockPanel>
</Window>
